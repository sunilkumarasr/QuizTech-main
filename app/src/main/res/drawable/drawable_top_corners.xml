<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Background color of the shape -->
    <solid android:color="@color/white" /> <!-- Replace with your color resource -->

    <!-- Define the corner radii -->
    <corners
        android:topLeftRadius="@dimen/_18sdp"
        android:topRightRadius="@dimen/_18sdp"
        android:bottomLeftRadius="0dp"
        android:bottomRightRadius="0dp" />

    <!-- Optional: Add a border (stroke) -->
    <!--
    <stroke
        android:width="1dp"
        android:color="@color/your_border_color" />
    -->

    <!-- Optional: Add padding if this drawable is set as a background
         and you want content within it to be padded -->
    <!--
    <padding
        android:left="10dp"
        android:top="10dp"
        android:right="10dp"
        android:bottom="10dp" />
    -->

</shape>
   