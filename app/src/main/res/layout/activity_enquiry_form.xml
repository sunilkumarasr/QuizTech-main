<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/img_bg_full"
    tools:context=".profile.EnquiryFormActivity">

    <include
        android:id="@+id/headerToolbar"
        layout="@layout/header_toolbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/llButtons"
        app:layout_constraintTop_toBottomOf="@id/headerToolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/textview_inter"
                android:text="Subject"
                android:textColor="@color/text_color_unselect"
                android:textSize="@dimen/_12sdp" />

            <EditText
                android:id="@+id/etSubject"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/edittext_rounded_bg_stroke"
                android:fontFamily="@font/inter"
                android:hint="Enter Subject"
                android:inputType="text"
                android:padding="@dimen/_12sdp"
                android:textSize="@dimen/_12sdp" />

            <TextView
                style="@style/textview_inter"
                android:layout_marginTop="16dp"
                android:text="Message"
                android:textColor="@color/text_color_unselect"
                android:textSize="@dimen/_12sdp" />

            <EditText
                android:id="@+id/etMessage"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/edittext_rounded_bg_stroke"
                android:fontFamily="@font/inter"
                android:gravity="top"
                android:hint="Enter message"
                android:inputType="textMultiLine"
                android:padding="@dimen/_12sdp"
                android:textSize="@dimen/_12sdp" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/llButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/button_background_white"
            android:fontFamily="@font/inter_semibold"
            android:text="Cancel"
            android:textAllCaps="false"
            android:textColor="@color/enroll_btn_color"
            android:textSize="@dimen/_14sdp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSend"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/button_rounded_teal_bg"
            android:fontFamily="@font/inter_semibold"
            android:text="Send"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="@dimen/_14sdp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>