<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/img_bg_full"
    tools:context=".auth.AddProfileDetailsActivity">



    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/btn_bottom"
        android:orientation="vertical"
        >



    <!-- Progress Bar (Visual Representation) -->
    <ProgressBar
        android:id="@+id/pbProfileProgress"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="12dp"
        android:layout_marginStart="@dimen/_16sdp"
        android:layout_marginTop="48dp"
        android:layout_marginEnd="@dimen/_32sdp"
        android:max="100"
        android:progress="50" 
        android:progressDrawable="@drawable/custom_progress_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvPersonalDetailsTitle"
        style="@style/loginTextviewTextStyleHeader"
        android:layout_marginTop="@dimen/_18sdp"
        app:layout_goneMarginStart="0dp"
        android:text="Personal Details"
        android:layout_marginStart="@dimen/_16sdp"
        app:layout_constraintStart_toStartOf="@+id/pbProfileProgress"
        app:layout_constraintTop_toBottomOf="@+id/pbProfileProgress" />

    <TextView
        android:id="@+id/tvCreateAccountSubtitle"
        style="@style/loginTextviewInputText"
        android:layout_marginStart="@dimen/_16sdp"
        android:textColor="@color/text_color_unselect"
        android:text="Create an account to continue!"
        app:layout_constraintStart_toStartOf="@+id/tvPersonalDetailsTitle"
        app:layout_constraintTop_toBottomOf="@+id/tvPersonalDetailsTitle" />
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_margin="@dimen/_16sdp"
              >
            <!-- Full Name -->
            <TextView
                android:id="@+id/tvFullNameLabel"
                android:layout_marginStart="0dp"
                android:text="Full Name"
                style="@style/loginTextviewInputText"
                android:textColor="@color/text_color_unselect"
                android:layout_marginTop="@dimen/_12sdp"
                />

            <EditText
                android:id="@+id/etFullName"
                android:hint="Sai Kumar"
                android:inputType="textPersonName"
                style="@style/loginEditTextStyle2"
                android:layout_marginTop="@dimen/_8sdp"
                />

            <!-- Gender -->
            <TextView
                android:id="@+id/tvGenderLabel"
                android:text="Gender"
                style="@style/loginTextviewInputText"
                android:layout_marginStart="0dp"
                android:layout_marginTop="@dimen/_16sdp" />

            <Spinner
                android:id="@+id/spinnerGender"


                style="@style/loginEditTextStyle2"
                android:layout_marginTop="@dimen/_8sdp" />

            <!-- Email ID -->
            <TextView
                android:id="@+id/tvEmailLabel"
                android:text="Email ID"
                style="@style/loginTextviewInputText"
                android:layout_marginTop="@dimen/_16sdp"
                android:layout_marginStart="0dp"
                />

            <EditText
                android:id="@+id/etEmail"
                android:hint="Saikumar@gmail.com"
                android:inputType="textEmailAddress"
android:editable="false"
                android:focusableInTouchMode="false"
                style="@style/loginEditTextStyle2"
                android:layout_marginTop="@dimen/_8sdp"
                />

            <!-- Phone Number -->
            <TextView
                android:id="@+id/tvPhoneNumberLabel"
                android:text="Phone Number"
                style="@style/loginTextviewInputText"
                android:layout_marginTop="@dimen/_16sdp"
                android:layout_marginStart="0dp"
                />

            <LinearLayout
                android:id="@+id/llPhoneNumber"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="@dimen/_8sdp"
                android:background="@drawable/edittext_rounded_bg_stroke"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                app:layout_constraintEnd_toEndOf="@+id/etEmail"
                app:layout_constraintStart_toStartOf="@+id/tvPhoneNumberLabel"
                app:layout_constraintTop_toBottomOf="@+id/tvPhoneNumberLabel">

                <com.hbb20.CountryCodePicker
                    android:id="@+id/ccp"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    app:ccp_showArrow="true"
                    app:ccp_showFlag="true"
                    app:ccp_showNameCode="false"
                    app:ccp_autoFormatNumber="true"
                    app:ccp_showPhoneCode="true"
                    app:ccp_showFullName="false"
                    app:ccp_textSize="13sp"
                    app:ccp_arrowSize="13sp"
                    app:ccpDialog_keyboardAutoPopup="false"/>

                <TextView
                    android:id="@+id/tvCountryCode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="+91"
                    android:visibility="gone"
                    android:textColor="@color/textColorPrimary"
                    android:textSize="16sp"
                    android:fontFamily="@font/roboto"/>

                <View
                    android:layout_width="1dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:background="@color/dividerColor" />

                <EditText
                    android:id="@+id/etPhoneNumber"
                    style="@style/loginEditTextStyle"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="Phone Number"
                    android:inputType="phone"
                    android:textSize="16sp"
                    android:layout_marginStart="0dp"
                    android:paddingStart="0dp"
                    android:fontFamily="@font/roboto"/>
            </LinearLayout>
            <TextView

                android:layout_marginStart="0dp"
                android:text="Address"
                style="@style/loginTextviewInputText"
                android:textColor="@color/text_color_unselect"
                android:layout_marginTop="@dimen/_12sdp"
                />

            <EditText
                android:id="@+id/etAddress"
                android:hint="Address"
                android:inputType="textPersonName"
                style="@style/loginEditTextStyle2"
                android:minLines="3"
                android:gravity="start"
                android:padding="@dimen/_5sdp"
                android:layout_height="@dimen/_80sdp"
                android:minHeight="@dimen/_80sdp"
                android:layout_marginTop="@dimen/_8sdp"
                />
        </LinearLayout>
    </ScrollView>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/btn_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:minHeight="@dimen/_80sdp"
        android:paddingRight="@dimen/_16sdp"
        android:gravity="center_vertical|right"
        android:background="@drawable/drawable_top_corners"

        >
        <Button
            android:id="@+id/btnNext"

            style="@style/loginBottonStyle"
            android:text="Next"
            android:layout_width="wrap_content"
            android:minWidth="@dimen/_150sdp"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="0dp"



            />
    </LinearLayout>

</RelativeLayout>
