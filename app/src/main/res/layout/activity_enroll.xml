<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/img_bg_full"
    tools:context=".enroll.EnrollActivity">

  <include layout="@layout/header_toolbar"
      android:id="@+id/layoutHeader"
      />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_marginHorizontal="@dimen/_16sdp"
        android:layout_weight="1"
        >
<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"

    android:layout_height="wrap_content">
    <TextView
        android:id="@+id/tvExamTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="SBI Clear Prelims 2024-25"
        android:textAppearance="@style/TextAppearance.AppCompat.Large"
        android:textColor="@color/quiztech_teal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/ivExamIcon"
        android:fontFamily="@font/poppins"
        android:textStyle="bold"
        android:textSize="@dimen/_16sdp"
        />

    <TextView
        android:id="@+id/tvExamDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="@dimen/_12sdp"
        android:textColor="@color/sub_heading_exam_color"
        android:text="Lorem Ipsum is simply dummy printing and typesetting"
        android:textAppearance="@style/TextAppearance.AppCompat.Small"
        app:layout_constraintTop_toBottomOf="@+id/tvExamTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/ivExamIcon" />

    <ImageView
        android:id="@+id/ivExamIcon"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginStart="16dp"
        android:src="@drawable/img_quiz"
        app:layout_constraintTop_toTopOf="@+id/tvExamTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/tvExamTitle"
        tools:ignore="ContentDescription" />

    <ImageView
        android:id="@+id/ivCalendarIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="24dp"
        android:src="@drawable/img_calender"
        app:layout_constraintTop_toBottomOf="@+id/tvExamDescription"
        app:layout_constraintStart_toStartOf="parent"
        tools:ignore="ContentDescription" />

    <TextView
        android:id="@+id/tvDateTimeLabel"
        style="@style/textview_inter"
        android:layout_marginStart="@dimen/_16sdp"
        android:text="Date and Time:"
        android:textSize="@dimen/_12sdp"
        android:textAppearance="@style/TextAppearance.AppCompat.Medium"
        app:layout_constraintTop_toTopOf="@+id/ivCalendarIcon"
        app:layout_constraintStart_toEndOf="@+id/ivCalendarIcon" />

    <TextView
        android:id="@+id/tvDateTimeValue"
        style="@style/textview_inter"
        android:layout_marginStart="@dimen/_16sdp"
        android:text="20-02-2025, 09:25 AM"
        android:textSize="@dimen/_12sdp"
        android:textAppearance="@style/TextAppearance.AppCompat.Medium"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@+id/tvDateTimeLabel"
        app:layout_constraintStart_toEndOf="@+id/ivCalendarIcon" />


</androidx.constraintlayout.widget.ConstraintLayout>



    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="wrap_content"
        android:minWidth="@dimen/_200sdp"
        android:layout_height="wrap_content"
        app:tabGravity="start"
        android:background="@color/white"
        app:tabIndicatorFullWidth="true"
        android:layout_marginTop="@dimen/_16sdp"
        app:tabIndicatorColor="@color/quiztech_teal">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/about_quiz" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/winnings" />
    </com.google.android.material.tabs.TabLayout>
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#D1D8DE"
            android:layout_marginBottom="@dimen/_16sdp"

            />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#00000000"
        />


    </LinearLayout>
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:contentPadding="@dimen/_16sdp"
        android:elevation="@dimen/_8sdp"
        >
        <TextView
            android:id="@+id/btnEnrollNow"
            style="@style/enrollBottonStyle"
            android:text="Enroll Now - ₹ 50"
            />
    </androidx.cardview.widget.CardView>

</LinearLayout>