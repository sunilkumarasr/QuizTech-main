<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    android:outlineAmbientShadowColor="#DCE9F2"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/textExamName"
            style="@style/textview_poppins"
            android:textColor="@color/colorPrimary"
            android:textStyle="bold"
            tools:text="SBI Clear Prelims 2024-25" />

        <TextView
            android:id="@+id/textExamType"
            style="@style/textview_inter"
            android:layout_marginTop="@dimen/_4sdp"
            android:textSize="@dimen/_10sdp"
            android:textColor="@color/sub_heading_exam_color"
            tools:text="Entrance exam" />

        <TextView
            android:id="@+id/textAttempts"
            style="@style/textview_inter"
            android:layout_marginTop="12dp"
            android:background="@drawable/ic_attempts_bg"
            android:paddingHorizontal="@dimen/_16sdp"
            android:text="450 Attempts"
            android:gravity="center_vertical"
            android:minHeight="@dimen/_40sdp"
            android:layout_width="match_parent"
            android:textColor="@color/attempts_text_color"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textQuestionsCount"
                style="@style/textview_inter"
                android:layout_marginTop="@dimen/_4sdp"
                tools:text="Questions Count: 100" />

            <TextView
                android:id="@+id/textMaxMarks"
                style="@style/textview_inter"
                android:layout_marginTop="@dimen/_4sdp"
                tools:text="Max Marks: 100" />

            <TextView
                android:id="@+id/textTime"
                style="@style/textview_inter"
                android:layout_marginTop="@dimen/_4sdp"
                tools:text="Time: 60 minutes" />

        </LinearLayout>
        <Button
            android:id="@+id/buttonEnrollNow"
            style="@style/enrollBottonStyle"
            android:text="@string/enroll_now"
            android:layout_marginTop="@dimen/_16sdp"

            />



    </LinearLayout>

</androidx.cardview.widget.CardView>
