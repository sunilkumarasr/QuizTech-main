<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".wallet.TransactionDetailsActivity">

    <include
        android:id="@+id/headerToolbar"
        layout="@layout/header_toolbar" />

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/headerToolbar"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="16dp">

            <ImageView
                android:id="@+id/ivStatusIcon"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginTop="16dp"
                android:src="@drawable/ic_checkmark_circle_green" />

            <TextView
                android:id="@+id/tvStatus"
                style="@style/textview_inter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Transfer Successful"
                android:textColor="@color/success_color"
                android:textSize="@dimen/_16sdp"
                android:textStyle="bold" />

            <TextView
                style="@style/textview_inter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_4sdp"
                android:text="Your transaction was successful"
                android:textColor="@color/sub_heading_exam_color"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvTransactionAmountHeader"
                style="@style/textview_inter_semi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="₹ 200.00"
                android:textColor="@color/black_semi"
                android:textSize="@dimen/_24sdp"
                android:textStyle="bold" />

            <androidx.cardview.widget.CardView
                android:id="@+id/layoutBankDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardBackgroundColor="#F5F5F5"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/textview_inter_semi"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Send to"
                        android:textColor="@color/text_color_unselect"
                        android:textSize="@dimen/_12sdp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical">

                        <ImageView
                            android:id="@+id/ivBankIcon"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/ic_idbi" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvBankName"
                                style="@style/textview_inter_semi"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="IDBI Bank"
                                android:textColor="@color/text_color_unselect"
                                android:textSize="@dimen/_12sdp" />

                            <TextView
                                android:id="@+id/tvAccountNumber"
                                style="@style/textview_inter_semi"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_4sdp"
                                android:text="**** - **** - 9876"
                                android:textColor="@color/sub_heading_exam_color"
                                android:textSize="@dimen/_10sdp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="#F5F5F5"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/textview_inter_semi"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Transaction Details"
                        android:textColor="@color/text_color_unselect"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp">

                        <TextView
                            style="@style/textview_inter_semi"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:text="Payment"
                            android:textColor="@color/sub_heading_exam_color"
                            android:textSize="@dimen/_12sdp" />

                        <TextView
                            android:id="@+id/tvPaymentAmount"
                            style="@style/textview_inter_semi"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:text="₹ 200.00"
                            android:textColor="@color/text_color_unselect"
                            android:textSize="@dimen/_13sdp" />
                    </RelativeLayout>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp">

                        <TextView
                            style="@style/textview_inter_semi"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:text="Date"
                            android:textColor="@color/sub_heading_exam_color"
                            android:textSize="@dimen/_12sdp" />

                        <TextView
                            android:id="@+id/tvDate"
                            style="@style/textview_inter_semi"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:text="30 Dec, 2024"
                            android:textColor="@color/text_color_unselect"
                            android:textSize="@dimen/_13sdp" />
                    </RelativeLayout>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp">

                        <TextView
                            style="@style/textview_inter_semi"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:text="Time"
                            android:textColor="@color/sub_heading_exam_color"
                            android:textSize="@dimen/_12sdp" />

                        <TextView
                            android:id="@+id/tvTime"
                            style="@style/textview_inter_semi"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:text="20:32"
                            android:textColor="@color/text_color_unselect"
                            android:textSize="@dimen/_13sdp" />
                    </RelativeLayout>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp">

                        <TextView
                            style="@style/textview_inter_semi"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:text="Reference Number"
                            android:textColor="@color/sub_heading_exam_color"
                            android:textSize="@dimen/_12sdp" />

                        <TextView
                            android:id="@+id/tvReferenceNumber"
                            style="@style/textview_inter_semi"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:text="QOIU-0012-ADFE-2234"
                            android:textColor="@color/text_color_unselect"
                            android:textSize="@dimen/_13sdp" />
                    </RelativeLayout>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp">

                        <TextView
                            style="@style/textview_inter_semi"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:text="Fee"
                            android:textColor="@color/sub_heading_exam_color"
                            android:textSize="@dimen/_12sdp" />

                        <TextView
                            style="@style/textview_inter_semi"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:text="₹ 0"
                            android:textColor="@color/text_color_unselect"
                            android:textSize="@dimen/_13sdp" />
                    </RelativeLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/tvNoData"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/headerToolbar"
        android:fontFamily="@font/poppins"
        android:gravity="center"
        android:text="No Transactions found"
        android:textColor="@color/black"
        android:textSize="@dimen/_14sdp"
        android:visibility="gone" />

</RelativeLayout>
