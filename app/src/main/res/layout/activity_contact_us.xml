<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/img_bg_full"
    tools:context=".profile.ContactUsActivity">

    <include
        android:id="@+id/headerToolbar"
        layout="@layout/header_toolbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:src="@drawable/ic_contact_us_banner"
                android:scaleType="centerCrop"/>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_location_pin" />

                        <TextView
                            style="@style/textview_inter_semi"
                            android:layout_marginStart="16dp"
                            android:text="Address"
                            android:textColor="@color/black_semi"
                            android:textSize="@dimen/_14sdp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        style="@style/textview_inter_semi"
                        android:layout_marginTop="8dp"
                        android:text="QuizTech"
                        android:textColor="@color/enroll_btn_color"
                        android:textSize="@dimen/_12sdp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txt_address"
                        style="@style/textview_inter"
                        android:layout_marginTop="4dp"
                        android:text=""
                        android:textColor="@color/text_color_unselect"
                        android:textSize="@dimen/_12sdp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_phone_contact" />

                        <TextView
                            style="@style/textview_inter_semi"
                            android:layout_marginStart="16dp"
                            android:text="Phone Number"
                            android:textColor="@color/black_semi"
                            android:textSize="@dimen/_14sdp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvLandline"
                        style="@style/textview_inter"
                        android:visibility="gone"
                        android:layout_marginTop="8dp"
                        android:text="Landline : 040-123456"
                        android:textColor="@color/text_color_unselect"
                        android:textSize="@dimen/_12sdp" />

                    <TextView
                        android:id="@+id/tvMobile1"
                        style="@style/textview_inter"
                        android:layout_marginTop="4dp"
                        android:text=""
                        android:textColor="@color/text_color_unselect"
                        android:textSize="@dimen/_12sdp" />

                    <TextView
                        android:id="@+id/tvMobile2"
                        style="@style/textview_inter"
                        android:layout_marginTop="4dp"
                        android:text=""
                        android:textColor="@color/text_color_unselect"
                        android:textSize="@dimen/_12sdp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_email_contact" />

                        <TextView
                            style="@style/textview_inter_semi"
                            android:layout_marginStart="16dp"
                            android:text="Email Address"
                            android:textColor="@color/black_semi"
                            android:textSize="@dimen/_14sdp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvEmail"
                        style="@style/textview_inter"
                        android:layout_marginTop="8dp"
                        android:text=""
                        android:textColor="@color/text_color_unselect"
                        android:textSize="@dimen/_12sdp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>