<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/img_bg_full"
    tools:context=".quiz.QuizActivity">
    <include layout="@layout/header_toolbar"
        android:id="@+id/toolbarHeader"
        />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/toolbarHeader"
        android:layout_above="@+id/bottom_layout"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_16sdp"
            android:orientation="vertical">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tvQuestionCount"
                    style="@style/textview_inter_semi"
                    android:layout_centerVertical="true"
                    android:text="1/20"
                    android:layout_marginStart="@dimen/_4sdp"
                    android:textColor="@android:color/black"
                    android:textSize="@dimen/_16sdp" />

                <TextView
                    android:id="@+id/tvTimer"
                    style="@style/textview_inter_semi"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:text="16:24 Min"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_16sdp" />

            </RelativeLayout>

            <ProgressBar
                android:id="@+id/progressBar"
                style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_6sdp"
                android:layout_marginTop="@dimen/_8sdp"
                android:max="100"
                android:progress="50"
                android:progressDrawable="@drawable/custom_progress_bar"
                />

            <WebView
                android:id="@+id/txt_question"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                />

            <LinearLayout
                android:id="@+id/lnrOption1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/_16sdp"
                android:minHeight="@dimen/_35sdp"
                android:layout_marginTop="@dimen/_12sdp"
                android:background="@drawable/round_selected"
                >
                <WebView
                    android:id="@+id/option1"
                    android:clickable="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/lnrOption2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/_16sdp"
                android:minHeight="@dimen/_35sdp"
                android:layout_marginTop="@dimen/_12sdp"
                android:background="@drawable/round_selected"
                >
                <WebView
                    android:id="@+id/option2"
                    android:clickable="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/lnrOption3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/_16sdp"
                android:layout_marginTop="@dimen/_12sdp"
                android:minHeight="@dimen/_35sdp"
                android:background="@drawable/round_selected"
                >
                <WebView
                    android:id="@+id/option3"
                    android:clickable="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/lnrOption4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/_16sdp"
                android:minHeight="@dimen/_35sdp"
                android:layout_marginTop="@dimen/_12sdp"
                android:background="@drawable/round_selected"
                >
                <WebView
                    android:id="@+id/option4"
                    android:clickable="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <androidx.cardview.widget.CardView
        android:id="@+id/bottom_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:contentPadding="@dimen/_16sdp"
        android:layout_alignParentBottom="true"
        app:cardElevation="@dimen/_8sdp"
        >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/previousButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/_8sdp"
                style="@style/enrollBottonStyle"
                app:backgroundTint="@color/enroll_btn_color"
                android:text="Previous"
                android:textAllCaps="false"
                android:textColor="@color/white" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/nextButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                style="@style/enrollBottonStyle"
                android:layout_marginStart="@dimen/_8sdp"
                app:backgroundTint="@color/enroll_btn_color"
                android:text="Next"
                android:textAllCaps="false" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</RelativeLayout>
