<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    android:id="@+id/swipeRefresh"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".home.HomeFragment">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/gradient_background_lite"
        >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <androidx.appcompat.widget.Toolbar
                        android:id="@+id/toolbar"
                        android:layout_width="match_parent"
                        android:layout_height="?attr/actionBarSize"
                        android:layout_marginHorizontal="@dimen/_16sdp"
                        android:layout_marginTop="@dimen/_8sdp"
                        app:contentInsetStart="0dp">

                        <ImageView
                            android:id="@+id/ivLogo"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/_32sdp"
                            android:adjustViewBounds="true"
                            android:contentDescription="QuizTech Logo"
                            android:src="@drawable/icon_home_logo" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_gravity="end"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/ivNotifications"
                                android:layout_width="@dimen/_28sdp"
                                android:layout_height="@dimen/_28sdp"
                                android:layout_marginEnd="@dimen/_8sdp"
                                android:padding="@dimen/_4sdp"
                                android:src="@drawable/ic_notifications" />

                            <ImageView
                                android:id="@+id/ivWhatsapp"
                                android:layout_width="@dimen/_28sdp"
                                android:layout_height="@dimen/_28sdp"
                                android:padding="@dimen/_4sdp"
                                android:src="@drawable/ic_whatsapp" />

                        </LinearLayout>

                    </androidx.appcompat.widget.Toolbar>

                    <androidx.viewpager2.widget.ViewPager2
                        android:id="@+id/viewPagerBanners"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_160sdp"
                        android:layout_marginHorizontal="@dimen/_12sdp"
                        android:layout_marginTop="@dimen/_12sdp" />

                    <com.tbuonomo.viewpagerdotsindicator.DotsIndicator
                        android:id="@+id/dotsIndicator"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="@dimen/_8sdp"
                        android:layout_marginBottom="@dimen/_8sdp"
                        app:dotsColor="#D9D9D9"
                        app:dotsCornerRadius="8dp"
                        app:dotsSize="8dp"
                        app:dotsSpacing="4dp"
                        app:dotsWidthFactor="2.5"
                        app:progressMode="true"
                        app:selectedDotColor="@color/quiztech_orange" />

                </LinearLayout>

                <ImageView
                    android:id="@+id/ivDefaultBanner"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_160sdp"
                    android:layout_marginHorizontal="@dimen/_12sdp"
                    android:layout_marginTop="@dimen/_76sdp"
                    android:contentDescription="Default Banner"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_home_top_bg"
                    android:visibility="gone" />

            </FrameLayout>


            <!-- Banner Image -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginHorizontal="@dimen/_16sdp"
                >

                <!-- Categories Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Categories"
                        android:textColor="@color/textColorPrimary"
                        android:textSize="@dimen/_18sdp"
                        android:fontFamily="@font/poppins"
                        android:textStyle="bold"
                        />

                    <TextView
                        android:id="@+id/tvCategoriesViewAll"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="View All"
                        android:textColor="@color/quiztech_orange"
                        android:textSize="@dimen/_12sdp"
                        android:fontFamily="@font/poppins"
                        android:textStyle="bold"
                        />
                </LinearLayout>

                <!-- Popular Mock Test Section -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvCategories"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:itemCount="3"
                    tools:listitem="@layout/item_category" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_16sdp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Popular Mock Test"
                        android:textColor="@color/textColorPrimary"
                        android:textSize="@dimen/_18sdp"
                        android:fontFamily="@font/poppins"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvMockTestViewAll"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="View All"
                        android:textColor="@color/quiztech_orange"
                        android:textSize="@dimen/_12sdp"
                        android:fontFamily="@font/poppins"
                        android:textStyle="bold"
                        />
                </LinearLayout>

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/rvMockTests"
                    android:layout_width="match_parent"
                    android:minHeight="@dimen/_180sdp"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="@dimen/_8sdp"
                    android:clipToPadding="false"
                    android:clipChildren="false" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/_16sdp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivPrevMock"
                        android:layout_width="@dimen/_24sdp"
                        android:layout_height="@dimen/_24sdp"
                        android:background="@drawable/bg_circle_black"
                        android:padding="@dimen/_6sdp"
                        android:src="@drawable/ic_arrow_back"
                        app:tint="@color/white" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <com.tbuonomo.viewpagerdotsindicator.DotsIndicator
                        android:id="@+id/dotsIndicatorMock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:dotsColor="#D9D9D9"
                        app:dotsCornerRadius="8dp"
                        app:dotsSize="8dp"
                        app:dotsSpacing="4dp"
                        app:dotsWidthFactor="2.5"
                        app:progressMode="true"
                        app:selectedDotColor="@color/quiztech_orange" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <ImageView
                        android:id="@+id/ivNextMock"
                        android:layout_width="@dimen/_24sdp"
                        android:layout_height="@dimen/_24sdp"
                        android:background="@drawable/bg_circle_black"
                        android:padding="@dimen/_6sdp"
                        android:rotation="180"
                        android:src="@drawable/ic_arrow_back"
                        app:tint="@color/white" />
                </LinearLayout>

            </LinearLayout>
            <!-- Second Banner (optional) -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/ivSecondBanner"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_150sdp"
                    android:scaleType="centerCrop"
                    android:background="@drawable/img_home_bg_bottom"
                    android:contentDescription="Daily Quiz Banner 2"/>
                <ImageView

                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/_80sdp"
                    android:layout_gravity="bottom"
                    android:scaleType="centerInside"
                    android:src="@drawable/icon_cup_home_bottom"
                    android:contentDescription="Daily Quiz Banner 2"/>
                <ImageView

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/_32sdp"

                    android:scaleType="centerInside"
                    android:src="@drawable/img_home_text_bottom"
                    android:contentDescription="Daily Quiz Banner 2"/>

                <ImageView

                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/_130sdp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"
                    android:scaleType="centerInside"
                    android:layout_gravity="right"
                    android:src="@drawable/icon_home_person"
                    android:contentDescription="Daily Quiz Banner 2"/>
            </FrameLayout>


        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>